{
  "name": "writecanvas",
  "productName": "WriteCanvas",
  "version": "0.1.2",
  "description": "Cross-platform note-taking & inking app. Reads and writes Scrble-Ink-compatible PNG notes (sINK replay + paper chunks).",
  "license": "Apache-2.0",
  "author": {
    "name": "ThanhNguyxnOrg",
    "email": "RealThanhNguyxn@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThanhNguyxnOrg/WriteCanvas.git"
  },
  "homepage": "https://github.com/ThanhNguyxnOrg/WriteCanvas#readme",
  "bugs": {
    "url": "https://github.com/ThanhNguyxnOrg/WriteCanvas/issues"
  },
  "main": "main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --remote-debugging-port=9222",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test tests/pen-paper.test.mjs tests/png-toolkit.test.mjs tests/shortcuts.test.mjs tests/library-pages.test.mjs tests/auto-merge.test.mjs tests/release-notes.test.mjs tests/workflows.test.mjs tests/package.test.mjs"
  },
  "build": {
    "appId": "com.writecanvas.app",
    "productName": "WriteCanvas",
    "files": [
      "main/**",
      "src/**",
      "preload.js",
      "node_modules/gifenc/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/img/writecanvas.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/img/writecanvas.png"
    },
    "linux": {
      "category": "Utility",
      "icon": "src/img/writecanvas.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
