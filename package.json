{
  "name": "writecanvas",
  "productName": "WriteCanvas",
  "version": "0.1.0",
  "description": "Cross-platform note-taking & inking app. Reads and writes Scrble-Ink-compatible PNG notes (sINK replay + paper chunks).",
  "main": "main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.writecanvas.app",
    "productName": "WriteCanvas",
    "files": [
      "main/**",
      "src/**",
      "node_modules/gifenc/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
